{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and operator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Mission": {
      "title": "Mission",
      "description": "Autonomous drone delivery mission",
      "type": "object",
      "properties": {
        "missionId": { "type": "string" },
        "workflowId": { "type": "string" },
        "droneId": { "type": "string" },
        "destination": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["missionId", "droneId", "destination", "status", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Operator profile collection"
    },
    "/missions/{missionId}": {
      "schema": "Mission",
      "description": "Persistent mission records"
    }
  }
}
